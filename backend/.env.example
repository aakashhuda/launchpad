APP_NAME=Launchpad Backend
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/launchpad
REDIS_URL=redis://localhost:6379/0
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MIN=30
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=1
GOOGLE_CLIENT_ID=
MAX_LAUNCHES_PER_FOUNDER_PER_DAY=2
