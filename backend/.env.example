APP_NAME=Launchpad Backend
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/launchpad
REDIS_URL=redis://localhost:6379/0
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MIN=30
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=1
GOOGLE_CLIENT_ID=
MAX_LAUNCHES_PER_FOUNDER_PER_DAY=2
DISCOVERY_CACHE_TTL_SECONDS=60

# Request correlation + structured logging (Phase 7).
CORRELATION_ID_HEADER=X-Request-Id

# Redis-backed rate limiting (fail-open, non-authoritative). Enabled by default;
# tests disable it via conftest.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_VOTE_PER_MINUTE=120
RATE_LIMIT_COMMENT_PER_MINUTE=30
RATE_LIMIT_REPORT_PER_MINUTE=20

# Suspicious-behavior monitoring thresholds (per member, in-window).
ABUSE_WINDOW_SECONDS=300
ABUSE_VOTE_THRESHOLD=40
ABUSE_COMMENT_THRESHOLD=20
ABUSE_REPORT_THRESHOLD=10

# Outbound email. Keep EMAIL_ENABLED=false to log instead of sending (dev/test);
# set true with SMTP_* for real delivery. Never commit real credentials.
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=no-reply@launchpad.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Notification delivery retry/backoff (provider-outage resilience).
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_BASE_SECONDS=5
NOTIFICATION_RETRY_MAX_SECONDS=300

# Directory for generated founder-export artifacts.
EXPORT_DIR=exports
