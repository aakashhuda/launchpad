{
  "info": {
    "name": "Launchpad Auth API",
    "description": "Launchpad backend Phase 2 — authentication, authorization & account lifecycle.\nImport this into Restfox via Import -> Postman Collection.\nSet the `baseUrl` variable (default http://localhost:8000) and run Signup/Login first; tokens are auto-saved to collection variables and used by protected requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000", "type": "string" },
    { "key": "access_token", "value": "", "type": "string" },
    { "key": "refresh_token", "value": "", "type": "string" },
    { "key": "user_email", "value": "tester@example.com", "type": "string" },
    { "key": "user_password", "value": "password123", "type": "string" },
    { "key": "new_password", "value": "newpass123", "type": "string" },
    { "key": "profile_slug", "value": "", "type": "string" },
    { "key": "verification_token", "value": "", "type": "string", "description": "Dev-only: generate via `from src.core.security import create_email_verification_token; create_email_verification_token(str(user_id))`" },
    { "key": "reset_token", "value": "", "type": "string", "description": "Dev-only: generate via `from src.core.security import create_password_reset_token; create_password_reset_token(str(user_id))`" },
    { "key": "google_id_token", "value": "", "type": "string", "description": "Real Google ID token; returns 501 until GOOGLE_CLIENT_ID is configured." }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.access_token) pm.collectionVariables.set('access_token', json.access_token);",
                  "if (json.refresh_token) pm.collectionVariables.set('refresh_token', json.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/signup",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "auth", "signup" ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\",\n  \"first_name\": \"Test\",\n  \"last_name\": \"User\",\n  \"nick_name\": \"testuser\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.access_token) pm.collectionVariables.set('access_token', json.access_token);",
                  "if (json.refresh_token) pm.collectionVariables.set('refresh_token', json.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "auth", "login" ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Refresh (rotate)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.access_token) pm.collectionVariables.set('access_token', json.access_token);",
                  "if (json.refresh_token) pm.collectionVariables.set('refresh_token', json.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "auth", "refresh" ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "auth", "logout" ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/verify-email",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "auth", "verify-email" ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{verification_token}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/forgot-password",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "auth", "forgot-password" ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/reset-password",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "auth", "reset-password" ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{reset_token}}\",\n  \"new_password\": \"{{new_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/change-password",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "auth", "change-password" ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"{{user_password}}\",\n  \"new_password\": \"{{new_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Google Sign-in",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/google",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "auth", "google" ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"{{google_id_token}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.profile && json.profile.slug) pm.collectionVariables.set('profile_slug', json.profile.slug);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "users", "me" ]
            }
          }
        },
        {
          "name": "Profile by slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{profile_slug}}",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "users", "{{profile_slug}}" ]
            }
          }
        }
      ]
    },
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/health",
          "host": [ "{{baseUrl}}" ],
          "path": [ "api", "v1", "health" ]
        }
      }
    }
  ]
}
